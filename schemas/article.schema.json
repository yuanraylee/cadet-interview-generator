{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cadet-interview-generator.local/schemas/article.schema.json",
  "title": "Cadet Interview Generator article",
  "description": "One bilingual reading article used by the static interview-practice website.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "category",
    "bank",
    "reviewStatus",
    "source",
    "paragraphs"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^article-[0-9]{3}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "category": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "bank": {
      "type": "string",
      "enum": ["primary", "extra"]
    },
    "reviewStatus": {
      "type": "string",
      "enum": ["draft", "legacy-imported", "reviewed", "published"]
    },
    "source": {
      "type": "string",
      "maxLength": 500
    },
    "paragraphs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["en", "zh"],
        "properties": {
          "en": {
            "type": "string",
            "minLength": 1
          },
          "zh": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
